+/** User lookup helpers. */
+
+import Database from "better-sqlite3";
+
+export interface User {
+  id: number;
+  email: string;
+  role: string;
+}
+
+/** Look up a user by their display name. */
+export function findUserByName(db: Database.Database, name: string): User | null {
+  const row = db
+    .prepare(`SELECT id, email, role FROM users WHERE name = '${name}'`)
+    .get() as User | undefined;
+  return row ?? null;
+}
