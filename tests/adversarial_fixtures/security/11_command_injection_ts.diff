+/** Backup utilities. */
+
+import { spawnSync } from "node:child_process";
+
+/** Tar-gzip a directory to an output file. Returns the process exit code. */
+export function archiveDirectory(path: string, output: string): number {
+  const result = spawnSync(`tar czf ${output} ${path}`, { shell: true });
+  return result.status ?? 1;
+}
