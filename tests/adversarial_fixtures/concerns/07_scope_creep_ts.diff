 /** Logging helpers. */

 import pino from "pino";
+import { mkdirSync } from "node:fs";
+import { join } from "node:path";

-const logger = pino({ name: "sandbox" });
+const logDir = process.env.SANDBOX_LOG_DIR ?? "/var/log/sandbox";
+mkdirSync(logDir, { recursive: true });
+
+const logger = pino(
+  { name: "sandbox.refactored", level: "debug" },
+  pino.multistream([
+    { level: "debug", stream: pino.destination(join(logDir, "sandbox.log")) },
+    { level: "debug", stream: process.stderr },
+  ]),
+);

 export function log(msg: string): void {
-  logger.info(msg);
+  logger.debug(msg);
 }
+
+// Backwards-compat alias for the old API
+export const logInfo = log;
