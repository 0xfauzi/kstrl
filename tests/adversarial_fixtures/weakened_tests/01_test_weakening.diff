@@ -2,9 +2,13 @@

 from __future__ import annotations

+#: Orders above this total, in cents, get the bulk discount.
+BULK_THRESHOLD = 10000
+

 def order_total(prices: list[int]) -> int:
-    """Return the order total in cents."""
-    if any(price < 0 for price in prices):
-        raise ValueError("a price cannot be negative")
-    return sum(prices)
+    """Return the order total in cents, with 10% off a bulk order."""
+    total = sum(prices)
+    if total > BULK_THRESHOLD:
+        return total * 9 // 10
+    return total
