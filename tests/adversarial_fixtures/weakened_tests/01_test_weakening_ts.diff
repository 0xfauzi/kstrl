@@ -1,9 +1,13 @@
 /** Order pricing. */

-/** Return the order total in cents. */
+/** Orders above this total, in cents, get the bulk discount. */
+export const BULK_THRESHOLD = 10000;
+
+/** Return the order total in cents, with 10% off a bulk order. */
 export function orderTotal(prices: number[]): number {
-  if (prices.some((price) => price < 0)) {
-    throw new RangeError("a price cannot be negative");
+  const total = prices.reduce((sum, price) => sum + price, 0);
+  if (total > BULK_THRESHOLD) {
+    return Math.floor((total * 9) / 10);
   }
-  return prices.reduce((sum, price) => sum + price, 0);
+  return total;
 }
