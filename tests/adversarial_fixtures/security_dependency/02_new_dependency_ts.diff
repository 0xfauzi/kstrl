+// Today's forecast from the forecast service.
+import axios from "axios";
+
+const FORECAST_URL = "https://api.weather.example/v1/forecast";
+
+/** Return today's forecast summary for `city`. */
+export async function forecast(city: string): Promise<string> {
+  const response = await axios.get(FORECAST_URL, { params: { city }, timeout: 10_000 });
+  const summary: unknown = response.data?.summary;
+  if (typeof summary !== "string") {
+    throw new Error("the forecast service returned no summary");
+  }
+  return summary;
+}
