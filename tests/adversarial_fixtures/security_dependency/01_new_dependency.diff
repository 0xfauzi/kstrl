+"""Today's forecast from the forecast service."""
+
+from __future__ import annotations
+
+import httpx
+
+FORECAST_URL = "https://api.weather.example/v1/forecast"
+
+
+def forecast(city: str) -> str:
+    """Return today's forecast summary for ``city``."""
+    response = httpx.get(FORECAST_URL, params={"city": city}, timeout=10.0)
+    response.raise_for_status()
+    summary = response.json().get("summary")
+    if not isinstance(summary, str):
+        raise ValueError("the forecast service returned no summary")
+    return summary
