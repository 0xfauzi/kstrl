+/** URL slug helpers (public API). */
+
+const NON_WORD = /[^a-z0-9]+/g;
+const NON_ASCII = /[\u0080-\uffff]/g;
+
+/**
+ * Return a lowercase, hyphen-separated slug for `text`.
+ *
+ * Accents are stripped, runs of non-word characters collapse to a
+ * single hyphen, and leading/trailing hyphens are trimmed. Exported
+ * from the textkit package index for downstream callers.
+ */
+export function slugify(text: string): string {
+  const asciiText = text.normalize("NFKD").replace(NON_ASCII, "");
+  const lowered = asciiText.toLowerCase();
+  const hyphenated = lowered.replace(NON_WORD, "-");
+  return hyphenated.replace(/^-+|-+$/g, "");
+}
